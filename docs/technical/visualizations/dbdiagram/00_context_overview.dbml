Project SmartFactory_Main_Nav_AI_Context {
  database_type: 'PostgreSQL'
  Note: '''
  Context overview for SmartFactory.
  Main owns DB truth. Nav owns motion/safety execution. AI owns evidence generation.
  Robot is bringup-only hardware endpoint.
  '''
}

Enum task_status {
  PLANNED
  READY
  RUNNING
  BLOCKED
  SAFETY_PAUSED
  OPERATOR_PAUSED
  SUCCEEDED
  FAILED
  CANCELLED
  MANUAL_REVIEW
}

Enum step_status {
  PLANNED
  READY
  LEASED
  COMMAND_SENT
  EXECUTING
  WAITING_EVIDENCE
  VERIFYING
  SUCCEEDED
  RETRY_WAIT
  BLOCKED
  SAFETY_PAUSED
  OPERATOR_PAUSED
  EMERGENCY_STOPPED
  MANUAL_REVIEW
  FAILED
  CANCELLED
}

Enum robot_status {
  IDLE
  RESERVED
  MOVING
  DOCKING
  LIFTING
  SAFETY_PAUSED
  OPERATOR_PAUSED
  EMERGENCY_STOPPED
  ERROR
  OFFLINE
  STALE
}

Table maps {
  id uuid [pk]
  code text [unique, not null]
  name text [not null]
  frame_id text [not null]
  map_version text
  active boolean
}

Table map_zones {
  id uuid [pk]
  map_id uuid [ref: > maps.id]
  code text [unique, not null]
  zone_type text [not null, note: 'INBOUND/STORAGE/OUTBOUND/WAIT/CHARGE/AISLE/RESTRICTED']
}

Table waypoints {
  id uuid [pk]
  map_id uuid [ref: > maps.id]
  zone_id uuid [ref: > map_zones.id]
  code text [unique, not null]
  waypoint_type text [not null, note: 'APPROACH/DOCKING_START/PARKING/CHARGE/WAIT/RECOVERY']
  pose_x double
  pose_y double
  pose_yaw double
}

Table storage_slots {
  id uuid [pk]
  code text [unique, not null]
  zone_id uuid [ref: > map_zones.id]
  approach_waypoint_id uuid [ref: > waypoints.id]
  docking_marker_id uuid
  status text [not null, note: 'EMPTY/RESERVED/OCCUPIED/BLOCKED/QUARANTINED/UNKNOWN/STALE']
}

Table robots {
  id uuid [pk]
  robot_code text [unique, not null, note: 'tb3_1/tb3_2']
  namespace text [unique, not null]
  status robot_status
  current_task_id uuid
  current_step_id uuid
  battery_level double
  last_heartbeat_at timestamptz
}

Table pallets {
  id uuid [pk]
  pallet_code text [unique, not null]
  part_id uuid
  quantity integer
  status text [not null, note: 'INBOUND/STORED/RESERVED_OUTBOUND/ON_ROBOT/OUTBOUND/QUARANTINED']
  current_slot_id uuid [ref: > storage_slots.id]
  current_robot_id uuid [ref: > robots.id]
}

Table work_orders {
  id uuid [pk]
  order_no bigint [unique]
  order_type text [not null, note: 'INBOUND_STORE/OUTBOUND_PICK/SLOT_VERIFY/MOVE_ONLY/RECOVERY']
  status text [not null]
  priority integer
}

Table tasks {
  id uuid [pk]
  task_no bigint [unique]
  work_order_id uuid [not null, ref: > work_orders.id]
  task_type text [not null, note: 'STORE_PALLET/PICK_PALLET/MOVE_ONLY/VERIFY_SLOT/RECOVERY']
  status task_status
  assigned_robot_id uuid [ref: > robots.id]
  target_pallet_id uuid [ref: > pallets.id]
  target_slot_id uuid [ref: > storage_slots.id]
}

Table task_steps {
  id uuid [pk]
  task_id uuid [not null, ref: > tasks.id]
  sequence_no integer [not null]
  step_type text [not null, note: 'MOVE/DOCK/LIFT/VERIFY/COMMIT']
  status step_status
  nav_command_id uuid
}

Table command_requests {
  id uuid [pk]
  command_type text [not null, note: 'NAV_GOAL/DOCK_ARUCO/LIFT_UP/LIFT_DOWN/STOP/PAUSE/RESUME']
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  status text [not null]
  idempotency_key text [unique, not null]
  fencing_token uuid
  deadline_at timestamptz
}

Table evidence_events {
  id uuid [pk]
  external_event_id text [not null]
  source_system text [not null, note: 'AI_SERVER/NAV_SERVER/ROBOT/OPERATOR/MAIN_SERVER']
  source_id text
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  evidence_type text [not null, note: 'HUMAN_DETECTED/ARUCO_MARKER_DETECTED/LIFT_LOAD_DETECTED/etc']
  severity text [not null, note: 'INFO/WARN/ERROR/SAFETY_CRITICAL']
  trusted_for_policy boolean
  observed_at timestamptz
}

Table state_transitions {
  id uuid [pk]
  entity_type text [not null, note: 'WORK_ORDER/TASK/TASK_STEP/ROBOT/SLOT/PALLET/COMMAND/LOCK/LEASE/INCIDENT']
  entity_id uuid [not null]
  from_status text
  to_status text [not null]
  reason_code text [not null]
  evidence_event_id uuid [ref: > evidence_events.id]
  command_id uuid [ref: > command_requests.id]
  created_by text [not null]
  created_at timestamptz
}

Ref: robots.current_task_id > tasks.id
Ref: robots.current_step_id > task_steps.id
Ref: task_steps.nav_command_id > command_requests.id
