Project SmartFactory_Map_Robot_Inventory {
  database_type: 'PostgreSQL'
  Note: 'Map, waypoint, docking, robot/source/sensor, slot/pallet/inventory domain.'
}

Table maps {
  id uuid [pk]
  code text [unique, not null]
  name text [not null]
  frame_id text [not null]
  map_version text
  origin_json jsonb
  active boolean
}

Table map_zones {
  id uuid [pk]
  map_id uuid [ref: > maps.id]
  code text [unique, not null]
  name text [not null]
  zone_type text [not null]
  polygon_json jsonb
  safety_policy_json jsonb
}

Table restricted_areas {
  id uuid [pk]
  map_id uuid [ref: > maps.id]
  zone_id uuid [ref: > map_zones.id]
  code text [unique, not null]
  restriction_type text [not null, note: 'NO_GO/SLOW_ZONE/ONE_WAY/HUMAN_SHARED/DOCKING_EXCLUSIVE']
  polygon_json jsonb
  policy_json jsonb
}

Table waypoints {
  id uuid [pk]
  map_id uuid [ref: > maps.id]
  zone_id uuid [ref: > map_zones.id]
  code text [unique, not null]
  name text [not null]
  waypoint_type text [not null]
  frame_id text
  pose_x double
  pose_y double
  pose_yaw double
  tolerance_xy_m double
  tolerance_yaw_rad double
}

Table waypoint_edges {
  id uuid [pk]
  from_waypoint_id uuid [not null, ref: > waypoints.id]
  to_waypoint_id uuid [not null, ref: > waypoints.id]
  edge_type text [not null]
  corridor_zone_id uuid [ref: > map_zones.id]
  nominal_distance_m double
  max_robot_count integer
  traversal_policy_json jsonb
}

Table docking_markers {
  id uuid [pk]
  waypoint_id uuid [ref: > waypoints.id]
  marker_family text [not null]
  marker_id integer [not null]
  purpose text [not null]
  expected_pose_json jsonb
  docking_profile_json jsonb
}

Table robots {
  id uuid [pk]
  robot_code text [unique, not null]
  namespace text [unique, not null]
  display_name text
  status text [not null]
  nav_status text
  current_task_id uuid
  current_step_id uuid
  battery_level double
  last_pose_json jsonb
  last_heartbeat_at timestamptz
}

Table robot_capabilities {
  robot_id uuid [ref: > robots.id]
  capability text [note: 'NAVIGATION/LIFT/PICAMERA/ARUCO_DOCKING/SAFETY_STOP']
  enabled boolean
  config_json jsonb

  indexes {
    (robot_id, capability) [pk]
  }
}

Table evidence_sources {
  id uuid [pk]
  source_id text [unique, not null, note: 'global_cam_01/tb3_1_picam/tb3_2_picam/nav_tb3_1']
  source_system text [not null]
  source_kind text [not null]
  robot_id uuid [ref: > robots.id]
  status text [not null]
  last_seen_at timestamptz
  trusted_for_safety boolean
  trusted_for_inventory boolean
}

Table source_health_samples {
  id uuid [pk]
  evidence_source_id uuid [not null, ref: > evidence_sources.id]
  status text [not null]
  latency_ms double
  frame_seq bigint
  observed_at timestamptz
}

Table sensor_calibrations {
  id uuid [pk]
  calibration_code text [unique, not null]
  calibration_type text [not null]
  version text [not null]
  calibration_json jsonb [not null]
  active boolean
}

Table sensor_mounts {
  id uuid [pk]
  evidence_source_id uuid [not null, ref: > evidence_sources.id]
  robot_id uuid [ref: > robots.id]
  zone_id uuid [ref: > map_zones.id]
  mount_type text [not null]
  frame_id text
  transform_json jsonb
  calibration_id uuid [ref: > sensor_calibrations.id]
}

Table robot_state_samples {
  id uuid [pk]
  robot_id uuid [not null, ref: > robots.id]
  pose_json jsonb
  velocity_json jsonb
  battery_level double
  lift_state text
  nav_state text
  observed_at timestamptz
}

Table lift_state_events {
  id uuid [pk]
  robot_id uuid [not null, ref: > robots.id]
  task_id uuid
  step_id uuid
  state text [not null]
  height_mm double
  load_detected boolean
  observed_at timestamptz
}

Table part_catalog {
  id uuid [pk]
  part_no text [unique, not null]
  name text [not null]
  category text
  spec_json jsonb
}

Table storage_slots {
  id uuid [pk]
  code text [unique, not null]
  zone_id uuid [not null, ref: > map_zones.id]
  approach_waypoint_id uuid [ref: > waypoints.id]
  docking_marker_id uuid [ref: > docking_markers.id]
  status text [not null]
  priority_score double
  last_verified_at timestamptz
}

Table pallets {
  id uuid [pk]
  pallet_code text [unique, not null]
  tag_id text
  marker_id text
  part_id uuid [ref: > part_catalog.id]
  quantity integer
  status text [not null]
  current_slot_id uuid [ref: > storage_slots.id]
  current_robot_id uuid [ref: > robots.id]
}

Table inventory_transactions {
  id uuid [pk]
  pallet_id uuid [not null, ref: > pallets.id]
  transaction_type text [not null, note: 'RECEIVE/STORE/PICK/SHIP/ADJUST/VERIFY/RESERVE']
  from_waypoint_id uuid [ref: > waypoints.id]
  to_waypoint_id uuid [ref: > waypoints.id]
  from_slot_id uuid [ref: > storage_slots.id]
  to_slot_id uuid [ref: > storage_slots.id]
  from_robot_id uuid [ref: > robots.id]
  to_robot_id uuid [ref: > robots.id]
  task_id uuid
  step_id uuid
  evidence_event_id uuid
  quantity integer
  created_at timestamptz
}
