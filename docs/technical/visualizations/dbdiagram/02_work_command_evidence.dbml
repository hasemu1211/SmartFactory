Project SmartFactory_Work_Command_Evidence {
  database_type: 'PostgreSQL'
  Note: 'Task state machine, Nav commands, evidence policy, safety incident lifecycle.'
}

Table robots {
  id uuid [pk]
  robot_code text [unique]
  status text
}

Table pallets {
  id uuid [pk]
  pallet_code text [unique]
  status text
}

Table storage_slots {
  id uuid [pk]
  code text [unique]
  status text
}

Table work_orders {
  id uuid [pk]
  order_no bigint [unique]
  order_type text [not null]
  status text [not null]
  priority integer
  requested_by text
  requested_payload_json jsonb
}

Table tasks {
  id uuid [pk]
  task_no bigint [unique]
  work_order_id uuid [not null, ref: > work_orders.id]
  task_type text [not null]
  status text [not null]
  priority integer
  assigned_robot_id uuid [ref: > robots.id]
  target_pallet_id uuid [ref: > pallets.id]
  source_waypoint_id uuid
  target_waypoint_id uuid
  source_slot_id uuid [ref: > storage_slots.id]
  target_slot_id uuid [ref: > storage_slots.id]
  timeout_at timestamptz
}

Table task_dependencies {
  task_id uuid [ref: > tasks.id]
  depends_on_task_id uuid [ref: > tasks.id]
  dependency_type text [not null]

  indexes {
    (task_id, depends_on_task_id) [pk]
  }
}

Table evidence_policies {
  id uuid [pk]
  policy_name text [not null]
  step_type text [not null]
  version integer
  policy_json jsonb [not null]
  active boolean
}

Table task_steps {
  id uuid [pk]
  task_id uuid [not null, ref: > tasks.id]
  sequence_no integer [not null]
  step_type text [not null, note: 'MOVE/DOCK/LIFT/VERIFY/COMMIT/RECOVERY']
  status text [not null]
  evidence_policy_id uuid [ref: > evidence_policies.id]
  nav_command_id uuid
  retry_count integer
  max_retries integer
  timeout_at timestamptz
}

Table reservations {
  id uuid [pk]
  reservation_type text [not null, note: 'ROBOT/SLOT/PALLET/ZONE/DOCKING_MARKER']
  robot_id uuid [ref: > robots.id]
  slot_id uuid [ref: > storage_slots.id]
  pallet_id uuid [ref: > pallets.id]
  task_id uuid [not null, ref: > tasks.id]
  status text [not null]
  expires_at timestamptz
  release_reason text
}

Table resource_locks {
  id uuid [pk]
  resource_type text [not null]
  resource_id uuid [not null]
  task_id uuid [not null, ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  lock_status text [not null]
  expires_at timestamptz
  owner text
}

Table scheduler_leases {
  step_id uuid [pk, ref: > task_steps.id]
  lease_owner text [not null]
  lease_token uuid [not null]
  heartbeat_at timestamptz
  expires_at timestamptz
}

Table command_requests {
  id uuid [pk]
  command_type text [not null, note: 'NAV_GOAL/DOCK_ARUCO/LIFT_UP/LIFT_DOWN/STOP/PAUSE/RESUME/CANCEL_COMMAND']
  target_system text [not null]
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  status text [not null]
  idempotency_key text [unique, not null]
  attempt_no integer
  fencing_token uuid
  map_id uuid
  map_version text
  calibration_version text
  deadline_at timestamptz
  superseded_by_command_id uuid [ref: > command_requests.id]
}

Table command_events {
  id uuid [pk]
  command_id uuid [not null, ref: > command_requests.id]
  source_system text [not null]
  external_event_id text [not null]
  event_sequence integer
  event_type text [not null, note: 'ACCEPTED/STARTED/FEEDBACK/SUCCEEDED/FAILED/ESTOPPED/SAFETY_PAUSED']
  fencing_token uuid
  observed_at timestamptz
}

Table docking_attempts {
  id uuid [pk]
  command_id uuid [ref: > command_requests.id]
  robot_id uuid [not null, ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  docking_marker_id uuid
  attempt_no integer
  error_xy_m double
  error_yaw_rad double
  stable_frame_count integer
  result text [not null]
  failure_reason text
}

Table evidence_artifacts {
  id uuid [pk]
  artifact_type text [not null]
  uri text [not null]
  content_hash text
  pii_redacted boolean
  access_policy text
  retention_until timestamptz
}

Table evidence_events {
  id uuid [pk]
  external_event_id text [not null]
  dedupe_key text [not null]
  source_system text [not null]
  source_id text
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  evidence_type text [not null]
  confidence double
  severity text [not null]
  trusted_for_policy boolean
  expires_at timestamptz
  artifact_ref_id uuid [ref: > evidence_artifacts.id]
  observed_at timestamptz
}

Table safety_incidents {
  id uuid [pk]
  incident_type text [not null]
  status text [not null]
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  triggering_evidence_id uuid [ref: > evidence_events.id]
  clear_evidence_id uuid [ref: > evidence_events.id]
  stop_command_id uuid [ref: > command_requests.id]
  acknowledged_by text
  resume_authorized_by text
}

Table safety_incident_events {
  id uuid [pk]
  incident_id uuid [not null, ref: > safety_incidents.id]
  event_type text [not null, note: 'DETECTED/INTERRUPT_SENT/STOP_ACKED/CLEAR_ACCEPTED/RESUME_AUTHORIZED']
  evidence_event_id uuid [ref: > evidence_events.id]
  command_event_id uuid [ref: > command_events.id]
  operator_id text
  observed_at timestamptz
}

Table decision_snapshots {
  id uuid [pk]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  decision_type text [not null]
  policy_version text
  normalized_input_json jsonb
  result_json jsonb
}

Table state_transitions {
  id uuid [pk]
  entity_type text [not null]
  entity_id uuid [not null]
  from_status text
  to_status text [not null]
  reason_code text [not null]
  actor_id text
  trace_id text
  evidence_event_id uuid [ref: > evidence_events.id]
  command_id uuid [ref: > command_requests.id]
  decision_snapshot_id uuid [ref: > decision_snapshots.id]
  created_by text [not null]
  created_at timestamptz
}

Ref: task_steps.nav_command_id > command_requests.id
