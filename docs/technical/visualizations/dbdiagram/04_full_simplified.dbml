Project SmartFactory_Full_Simplified {
  database_type: 'PostgreSQL'
  Note: '''
  Compact all-in-one diagram for dbdiagram.io.
  Use split files 01~03 for detailed review. This file keeps only key columns/relations.
  '''
}

Table maps {
  id uuid [pk]
  code text [unique, not null]
  frame_id text [not null]
  map_version text
  active boolean
}

Table map_zones {
  id uuid [pk]
  map_id uuid [not null, ref: > maps.id]
  code text [unique, not null]
  zone_type text [not null, note: 'INBOUND/STORAGE/OUTBOUND/CHARGE/AISLE/RESTRICTED']
}

Table waypoints {
  id uuid [pk]
  map_id uuid [not null, ref: > maps.id]
  zone_id uuid [ref: > map_zones.id]
  code text [unique, not null]
  waypoint_type text [not null, note: 'APPROACH/DOCKING_START/PARKING/CHARGE/WAIT/RECOVERY']
  pose_x double
  pose_y double
  pose_yaw double
}

Table waypoint_edges {
  id uuid [pk]
  from_waypoint_id uuid [not null, ref: > waypoints.id]
  to_waypoint_id uuid [not null, ref: > waypoints.id]
  edge_type text [not null]
  max_robot_count integer
}

Table docking_markers {
  id uuid [pk]
  waypoint_id uuid [ref: > waypoints.id]
  marker_family text [not null]
  marker_id integer [not null]
  purpose text [not null]
}

Table storage_slots {
  id uuid [pk]
  code text [unique, not null]
  zone_id uuid [not null, ref: > map_zones.id]
  approach_waypoint_id uuid [ref: > waypoints.id]
  docking_marker_id uuid [ref: > docking_markers.id]
  status text [not null, note: 'EMPTY/RESERVED/OCCUPIED/BLOCKED/QUARANTINED/UNKNOWN']
}

Table robots {
  id uuid [pk]
  robot_code text [unique, not null]
  namespace text [unique, not null]
  status text [not null, note: 'IDLE/RESERVED/MOVING/DOCKING/LIFTING/SAFETY_PAUSED/ERROR/OFFLINE']
  current_task_id uuid
  current_step_id uuid
  battery_level double
  last_heartbeat_at timestamptz
}

Table robot_capabilities {
  robot_id uuid [ref: > robots.id]
  capability text [note: 'NAVIGATION/LIFT/PICAMERA/ARUCO_DOCKING/SAFETY_STOP']
  enabled boolean

  indexes {
    (robot_id, capability) [pk]
  }
}

Table evidence_sources {
  id uuid [pk]
  source_id text [unique, not null]
  source_system text [not null, note: 'AI_SERVER/NAV_SERVER/ROBOT/MAIN_SERVER']
  source_kind text [not null, note: 'GLOBAL_CAMERA/PICAMERA/NAV_STATUS/LIFT_SENSOR']
  robot_id uuid [ref: > robots.id]
  status text [not null]
  trusted_for_safety boolean
  trusted_for_inventory boolean
}

Table sensor_calibrations {
  id uuid [pk]
  calibration_code text [unique, not null]
  calibration_type text [not null]
  version text [not null]
  active boolean
}

Table sensor_mounts {
  id uuid [pk]
  evidence_source_id uuid [not null, ref: > evidence_sources.id]
  robot_id uuid [ref: > robots.id]
  zone_id uuid [ref: > map_zones.id]
  calibration_id uuid [ref: > sensor_calibrations.id]
  mount_type text [not null]
}

Table part_catalog {
  id uuid [pk]
  part_no text [unique, not null]
  name text [not null]
}

Table pallets {
  id uuid [pk]
  pallet_code text [unique, not null]
  part_id uuid [ref: > part_catalog.id]
  quantity integer
  status text [not null, note: 'INBOUND/STORED/RESERVED_OUTBOUND/ON_ROBOT/OUTBOUND/QUARANTINED']
  current_slot_id uuid [ref: > storage_slots.id]
  current_robot_id uuid [ref: > robots.id]
}

Table inventory_transactions {
  id uuid [pk]
  pallet_id uuid [not null, ref: > pallets.id]
  transaction_type text [not null]
  from_slot_id uuid [ref: > storage_slots.id]
  to_slot_id uuid [ref: > storage_slots.id]
  from_robot_id uuid [ref: > robots.id]
  to_robot_id uuid [ref: > robots.id]
  task_id uuid
  evidence_event_id uuid
  created_at timestamptz
}

Table work_orders {
  id uuid [pk]
  order_no bigint [unique]
  order_type text [not null, note: 'INBOUND_STORE/OUTBOUND_PICK/SLOT_VERIFY/MOVE_ONLY/RECOVERY']
  status text [not null]
  priority integer
}

Table tasks {
  id uuid [pk]
  task_no bigint [unique]
  work_order_id uuid [not null, ref: > work_orders.id]
  task_type text [not null, note: 'STORE_PALLET/PICK_PALLET/MOVE_ONLY/VERIFY_SLOT/RECOVERY']
  status text [not null]
  assigned_robot_id uuid [ref: > robots.id]
  target_pallet_id uuid [ref: > pallets.id]
  source_slot_id uuid [ref: > storage_slots.id]
  target_slot_id uuid [ref: > storage_slots.id]
}

Table task_dependencies {
  task_id uuid [ref: > tasks.id]
  depends_on_task_id uuid [ref: > tasks.id]
  dependency_type text [not null]

  indexes {
    (task_id, depends_on_task_id) [pk]
  }
}

Table evidence_policies {
  id uuid [pk]
  policy_name text [not null]
  step_type text [not null]
  version integer
  active boolean
}

Table task_steps {
  id uuid [pk]
  task_id uuid [not null, ref: > tasks.id]
  sequence_no integer [not null]
  step_type text [not null, note: 'MOVE/DOCK/LIFT/VERIFY/COMMIT']
  status text [not null]
  evidence_policy_id uuid [ref: > evidence_policies.id]
  nav_command_id uuid
  retry_count integer
  timeout_at timestamptz
}

Table reservations {
  id uuid [pk]
  reservation_type text [not null, note: 'ROBOT/SLOT/PALLET/ZONE/DOCKING_MARKER']
  robot_id uuid [ref: > robots.id]
  slot_id uuid [ref: > storage_slots.id]
  pallet_id uuid [ref: > pallets.id]
  task_id uuid [not null, ref: > tasks.id]
  status text [not null]
  expires_at timestamptz
}

Table resource_locks {
  id uuid [pk]
  resource_type text [not null]
  resource_id uuid [not null]
  task_id uuid [not null, ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  lock_status text [not null]
  expires_at timestamptz
}

Table scheduler_leases {
  step_id uuid [pk, ref: > task_steps.id]
  lease_owner text [not null]
  lease_token uuid [not null]
  expires_at timestamptz
}

Table command_requests {
  id uuid [pk]
  command_type text [not null, note: 'NAV_GOAL/DOCK_ARUCO/LIFT_UP/LIFT_DOWN/STOP/PAUSE/RESUME/CANCEL_COMMAND']
  target_system text [not null]
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  status text [not null]
  idempotency_key text [unique, not null]
  fencing_token uuid
  deadline_at timestamptz
  superseded_by_command_id uuid [ref: > command_requests.id]
}

Table command_events {
  id uuid [pk]
  command_id uuid [not null, ref: > command_requests.id]
  source_system text [not null]
  external_event_id text [not null]
  event_type text [not null, note: 'ACCEPTED/STARTED/FEEDBACK/SUCCEEDED/FAILED/SAFETY_PAUSED']
  observed_at timestamptz
}

Table docking_attempts {
  id uuid [pk]
  command_id uuid [ref: > command_requests.id]
  robot_id uuid [not null, ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  docking_marker_id uuid [ref: > docking_markers.id]
  result text [not null]
}

Table evidence_artifacts {
  id uuid [pk]
  artifact_type text [not null]
  uri text [not null]
  content_hash text
  retention_until timestamptz
}

Table evidence_events {
  id uuid [pk]
  external_event_id text [not null]
  dedupe_key text [not null]
  source_system text [not null]
  source_id text
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  evidence_type text [not null]
  severity text [not null]
  trusted_for_policy boolean
  artifact_ref_id uuid [ref: > evidence_artifacts.id]
  observed_at timestamptz
}

Table safety_incidents {
  id uuid [pk]
  incident_type text [not null]
  status text [not null]
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  triggering_evidence_id uuid [ref: > evidence_events.id]
  clear_evidence_id uuid [ref: > evidence_events.id]
  stop_command_id uuid [ref: > command_requests.id]
}

Table safety_incident_events {
  id uuid [pk]
  incident_id uuid [not null, ref: > safety_incidents.id]
  event_type text [not null]
  evidence_event_id uuid [ref: > evidence_events.id]
  command_event_id uuid [ref: > command_events.id]
  observed_at timestamptz
}

Table decision_snapshots {
  id uuid [pk]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  decision_type text [not null]
  normalized_input_json jsonb
  result_json jsonb
}

Table state_transitions {
  id uuid [pk]
  entity_type text [not null]
  entity_id uuid [not null]
  from_status text
  to_status text [not null]
  reason_code text [not null]
  evidence_event_id uuid [ref: > evidence_events.id]
  command_id uuid [ref: > command_requests.id]
  decision_snapshot_id uuid [ref: > decision_snapshots.id]
  created_by text [not null]
  created_at timestamptz
}

Table api_call_logs {
  id uuid [pk]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  command_id uuid [ref: > command_requests.id]
  target_system text [not null]
  method text [not null]
  url text [not null]
  response_status integer
  started_at timestamptz
  finished_at timestamptz
}

Table inbox_events {
  id uuid [pk]
  source_system text [not null]
  external_event_id text [not null]
  event_type text [not null]
  processing_status text [not null]
  dead_lettered_at timestamptz
}

Table outbox_events {
  id uuid [pk]
  event_type text [not null]
  target_system text [not null]
  aggregate_type text [not null]
  aggregate_id uuid [not null]
  delivery_status text [not null]
  dead_lettered_at timestamptz
}

Table dead_letter_events {
  id uuid [pk]
  source_table text [not null]
  source_event_id uuid [not null]
  reason_code text [not null]
  resolved_at timestamptz
}

Table operator_actions {
  id uuid [pk]
  operator_id text [not null]
  action_type text [not null]
  target_entity_type text [not null]
  target_entity_id uuid [not null]
  created_at timestamptz
}

Table manual_control_sessions {
  id uuid [pk]
  robot_id uuid [not null, ref: > robots.id]
  operator_id text [not null]
  status text [not null]
  started_at timestamptz
  reconciled_at timestamptz
  closed_at timestamptz
}

Table service_identities {
  id uuid [pk]
  service_name text [unique, not null]
  service_type text [not null]
  auth_scheme text [not null]
  active boolean
}

Table api_auth_audit {
  id uuid [pk]
  service_identity_id uuid [ref: > service_identities.id]
  endpoint text [not null]
  method text [not null]
  auth_result text [not null]
  request_id text
  created_at timestamptz
}

Ref: robots.current_task_id > tasks.id
Ref: robots.current_step_id > task_steps.id
Ref: task_steps.nav_command_id > command_requests.id
Ref: inventory_transactions.task_id > tasks.id
Ref: inventory_transactions.evidence_event_id > evidence_events.id
