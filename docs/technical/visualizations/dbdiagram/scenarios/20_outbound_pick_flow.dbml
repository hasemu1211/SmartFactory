Project Scenario_20_Outbound_Pick_Flow {
  database_type: 'PostgreSQL'
  Note: '''
  Scenario: requested part/pallet is reserved in storage, robot picks it, moves to outbound zone, drops it, and inventory is shipped/committed.
  '''
}

Table work_orders {
  id uuid [pk]
  order_no bigint [unique]
  order_type text [not null, note: 'OUTBOUND_PICK']
  status text [not null]
  priority integer
  requested_payload_json jsonb
}

Table tasks {
  id uuid [pk]
  task_no bigint [unique]
  work_order_id uuid [not null, ref: > work_orders.id]
  task_type text [not null, note: 'PICK_PALLET']
  status text [not null]
  assigned_robot_id uuid [ref: > robots.id]
  target_pallet_id uuid [ref: > pallets.id]
  source_slot_id uuid [ref: > storage_slots.id]
  target_waypoint_id uuid [ref: > waypoints.id]
  priority integer
}

Table task_steps {
  id uuid [pk]
  task_id uuid [not null, ref: > tasks.id]
  sequence_no integer [not null]
  step_type text [not null, note: 'MOVE_TO_SLOT/DOCK_SLOT/LIFT_UP/MOVE_TO_OUTBOUND/LIFT_DOWN/VERIFY_OUTBOUND/COMMIT_SHIP']
  status text [not null]
  nav_command_id uuid
  evidence_policy_id uuid [ref: > evidence_policies.id]
}

Table robots {
  id uuid [pk]
  robot_code text [unique, not null]
  status text [not null]
  current_task_id uuid
  current_step_id uuid
  battery_level double
}

Table waypoints {
  id uuid [pk]
  code text [unique, not null]
  waypoint_type text [not null, note: 'STORAGE_APPROACH/OUTBOUND_DROPOFF/DOCKING_START']
  pose_x double
  pose_y double
  pose_yaw double
}

Table storage_slots {
  id uuid [pk]
  code text [unique, not null]
  approach_waypoint_id uuid [ref: > waypoints.id]
  docking_marker_id uuid [ref: > docking_markers.id]
  status text [not null, note: 'OCCUPIED/RESERVED/BLOCKED/EMPTY']
}

Table docking_markers {
  id uuid [pk]
  waypoint_id uuid [ref: > waypoints.id]
  marker_family text [not null]
  marker_id integer [not null]
  purpose text [not null, note: 'SLOT_PICK/OUTBOUND_DROP']
}

Table part_catalog {
  id uuid [pk]
  part_no text [unique, not null]
  name text [not null]
}

Table pallets {
  id uuid [pk]
  pallet_code text [unique, not null]
  part_id uuid [ref: > part_catalog.id]
  quantity integer
  status text [not null, note: 'STORED/RESERVED_OUTBOUND/ON_ROBOT/OUTBOUND/SHIPPED']
  current_slot_id uuid [ref: > storage_slots.id]
  current_robot_id uuid [ref: > robots.id]
}

Table reservations {
  id uuid [pk]
  reservation_type text [not null, note: 'ROBOT/SLOT/PALLET/OUTBOUND_LANE']
  robot_id uuid [ref: > robots.id]
  slot_id uuid [ref: > storage_slots.id]
  pallet_id uuid [ref: > pallets.id]
  task_id uuid [not null, ref: > tasks.id]
  status text [not null]
  expires_at timestamptz
}

Table command_requests {
  id uuid [pk]
  command_type text [not null, note: 'NAV_GOAL/DOCK_ARUCO/LIFT_UP/LIFT_DOWN']
  target_system text [not null]
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  status text [not null]
  idempotency_key text [unique, not null]
  deadline_at timestamptz
}

Table command_events {
  id uuid [pk]
  command_id uuid [not null, ref: > command_requests.id]
  event_type text [not null]
  observed_at timestamptz
}

Table evidence_policies {
  id uuid [pk]
  policy_name text [not null]
  step_type text [not null]
  version integer
  policy_json jsonb [not null]
}

Table evidence_events {
  id uuid [pk]
  source_system text [not null, note: 'AI_SERVER/NAV_SERVER/ROBOT']
  source_id text
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  evidence_type text [not null, note: 'SLOT_OCCUPIED_CONFIRMED/LIFT_LOAD_DETECTED/OUTBOUND_DROP_CONFIRMED']
  confidence double
  trusted_for_policy boolean
  observed_at timestamptz
}

Table inventory_transactions {
  id uuid [pk]
  pallet_id uuid [not null, ref: > pallets.id]
  transaction_type text [not null, note: 'RESERVE/PICK/SHIP/VERIFY']
  from_slot_id uuid [ref: > storage_slots.id]
  from_robot_id uuid [ref: > robots.id]
  to_robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  evidence_event_id uuid [ref: > evidence_events.id]
  quantity integer
  created_at timestamptz
}

Table state_transitions {
  id uuid [pk]
  entity_type text [not null]
  entity_id uuid [not null]
  from_status text
  to_status text [not null]
  reason_code text [not null]
  evidence_event_id uuid [ref: > evidence_events.id]
  command_id uuid [ref: > command_requests.id]
  created_by text [not null]
  created_at timestamptz
}

Ref: robots.current_task_id > tasks.id
Ref: robots.current_step_id > task_steps.id
Ref: task_steps.nav_command_id > command_requests.id
