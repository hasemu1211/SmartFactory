Project Scenario_50_Multi_Robot_Reservation_Dispatch {
  database_type: 'PostgreSQL'
  Note: '''
  Scenario: Main scheduler selects one of two robots, reserves robot/pallet/slot/zone resources, leases the next step, and avoids conflicts on shared waypoints/docking zones.
  '''
}

Table robots {
  id uuid [pk]
  robot_code text [unique, not null, note: 'tb3_1/tb3_2']
  namespace text [unique, not null]
  status text [not null, note: 'IDLE/RESERVED/MOVING/DOCKING/CHARGING/OFFLINE']
  battery_level double
  last_pose_json jsonb
  last_heartbeat_at timestamptz
}

Table robot_capabilities {
  robot_id uuid [ref: > robots.id]
  capability text [note: 'NAVIGATION/LIFT/PICAMERA/ARUCO_DOCKING/SAFETY_STOP']
  enabled boolean
  config_json jsonb

  indexes {
    (robot_id, capability) [pk]
  }
}

Table robot_state_samples {
  id uuid [pk]
  robot_id uuid [not null, ref: > robots.id]
  pose_json jsonb
  battery_level double
  lift_state text
  nav_state text
  observed_at timestamptz
}

Table maps {
  id uuid [pk]
  code text [unique, not null]
  map_version text
  active boolean
}

Table map_zones {
  id uuid [pk]
  map_id uuid [ref: > maps.id]
  code text [unique, not null]
  zone_type text [not null, note: 'STORAGE/INBOUND/OUTBOUND/AISLE/CHARGE/RESTRICTED']
}

Table waypoints {
  id uuid [pk]
  map_id uuid [ref: > maps.id]
  zone_id uuid [ref: > map_zones.id]
  code text [unique, not null]
  waypoint_type text [not null]
}

Table waypoint_edges {
  id uuid [pk]
  from_waypoint_id uuid [not null, ref: > waypoints.id]
  to_waypoint_id uuid [not null, ref: > waypoints.id]
  corridor_zone_id uuid [ref: > map_zones.id]
  edge_type text [not null]
  max_robot_count integer
  traversal_policy_json jsonb
}

Table storage_slots {
  id uuid [pk]
  code text [unique, not null]
  zone_id uuid [not null, ref: > map_zones.id]
  approach_waypoint_id uuid [ref: > waypoints.id]
  status text [not null]
}

Table pallets {
  id uuid [pk]
  pallet_code text [unique, not null]
  status text [not null]
  current_slot_id uuid [ref: > storage_slots.id]
  current_robot_id uuid [ref: > robots.id]
}

Table tasks {
  id uuid [pk]
  task_no bigint [unique]
  task_type text [not null]
  status text [not null, note: 'READY/RUNNING/BLOCKED/SAFETY_PAUSED/SUCCEEDED/FAILED']
  assigned_robot_id uuid [ref: > robots.id]
  target_pallet_id uuid [ref: > pallets.id]
  target_slot_id uuid [ref: > storage_slots.id]
  priority integer
}

Table task_steps {
  id uuid [pk]
  task_id uuid [not null, ref: > tasks.id]
  sequence_no integer [not null]
  step_type text [not null]
  status text [not null, note: 'READY/LEASED/COMMAND_SENT/EXECUTING/SUCCEEDED/BLOCKED']
}

Table reservations {
  id uuid [pk]
  reservation_type text [not null, note: 'ROBOT/SLOT/PALLET/ZONE/DOCKING_MARKER']
  robot_id uuid [ref: > robots.id]
  slot_id uuid [ref: > storage_slots.id]
  pallet_id uuid [ref: > pallets.id]
  zone_id uuid [ref: > map_zones.id]
  task_id uuid [not null, ref: > tasks.id]
  status text [not null, note: 'ACTIVE/RELEASED/EXPIRED/CANCELLED']
  expires_at timestamptz
}

Table resource_locks {
  id uuid [pk]
  resource_type text [not null, note: 'WAYPOINT_EDGE/ZONE/SLOT/ROBOT']
  resource_id uuid [not null]
  task_id uuid [not null, ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  lock_status text [not null]
  expires_at timestamptz
  owner text
}

Table scheduler_leases {
  step_id uuid [pk, ref: > task_steps.id]
  lease_owner text [not null]
  lease_token uuid [not null]
  heartbeat_at timestamptz
  expires_at timestamptz
}

Table command_requests {
  id uuid [pk]
  command_type text [not null, note: 'NAV_GOAL/DOCK_ARUCO/LIFT_UP/LIFT_DOWN']
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  status text [not null]
  idempotency_key text [unique, not null]
  fencing_token uuid
}

Table state_transitions {
  id uuid [pk]
  entity_type text [not null, note: 'TASK/TASK_STEP/ROBOT/RESERVATION/LOCK/LEASE']
  entity_id uuid [not null]
  from_status text
  to_status text [not null]
  reason_code text [not null]
  command_id uuid [ref: > command_requests.id]
  created_by text [not null]
  created_at timestamptz
}
