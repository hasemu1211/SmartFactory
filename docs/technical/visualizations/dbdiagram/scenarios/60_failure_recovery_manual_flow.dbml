Project Scenario_60_Failure_Recovery_Manual_Flow {
  database_type: 'PostgreSQL'
  Note: '''
  Scenario: command timeout or bad evidence causes retry/recovery/manual review. Main keeps API call logs, inbox/outbox status, dead letters, operator action, and state transitions.
  '''
}

Table tasks {
  id uuid [pk]
  task_no bigint [unique]
  task_type text [not null]
  status text [not null, note: 'RUNNING/RETRY_WAIT/BLOCKED/MANUAL_REVIEW/FAILED/RECOVERY']
  assigned_robot_id uuid [ref: > robots.id]
  parent_task_id uuid [ref: > tasks.id]
}

Table task_steps {
  id uuid [pk]
  task_id uuid [not null, ref: > tasks.id]
  sequence_no integer [not null]
  step_type text [not null]
  status text [not null, note: 'COMMAND_SENT/EXECUTING/WAITING_EVIDENCE/RETRY_WAIT/BLOCKED/MANUAL_REVIEW/FAILED']
  nav_command_id uuid
  retry_count integer
  max_retries integer
  timeout_at timestamptz
}

Table robots {
  id uuid [pk]
  robot_code text [unique, not null]
  status text [not null, note: 'ERROR/OFFLINE/STALE/OPERATOR_PAUSED/IDLE']
  last_heartbeat_at timestamptz
}

Table command_requests {
  id uuid [pk]
  command_type text [not null]
  target_system text [not null, note: 'NAV_SERVER/AI_SERVER']
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  status text [not null, note: 'PENDING/SENT/ACKED/SUCCEEDED/FAILED/TIMEOUT/CANCELLED/SUPERSEDED']
  idempotency_key text [unique, not null]
  attempt_no integer
  fencing_token uuid
  deadline_at timestamptz
  superseded_by_command_id uuid [ref: > command_requests.id]
}

Table command_events {
  id uuid [pk]
  command_id uuid [not null, ref: > command_requests.id]
  source_system text [not null]
  external_event_id text [not null]
  event_type text [not null, note: 'ACCEPTED/STARTED/FEEDBACK/SUCCEEDED/FAILED/TIMEOUT/CANCELLED']
  observed_at timestamptz
}

Table api_call_logs {
  id uuid [pk]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  command_id uuid [ref: > command_requests.id]
  target_system text [not null]
  method text [not null]
  url text [not null]
  request_hash text
  response_status integer
  response_hash text
  idempotency_key text
  started_at timestamptz
  finished_at timestamptz
  error_code text
}

Table inbox_events {
  id uuid [pk]
  source_system text [not null]
  external_event_id text [not null]
  event_type text [not null]
  payload_json jsonb [not null]
  processing_status text [not null, note: 'PENDING/PROCESSED/FAILED/DEAD_LETTERED']
  retry_count integer
  max_attempts integer
  next_attempt_at timestamptz
  dead_lettered_at timestamptz
}

Table outbox_events {
  id uuid [pk]
  event_type text [not null]
  target_system text [not null]
  aggregate_type text [not null]
  aggregate_id uuid [not null]
  payload_json jsonb [not null]
  delivery_status text [not null, note: 'PENDING/SENT/ACKED/FAILED/DEAD_LETTERED']
  next_attempt_at timestamptz
  delivery_deadline_at timestamptz
  retry_count integer
  max_attempts integer
  dead_lettered_at timestamptz
}

Table dead_letter_events {
  id uuid [pk]
  source_table text [not null, note: 'inbox_events/outbox_events']
  source_event_id uuid [not null]
  reason_code text [not null]
  payload_json jsonb
  error_message text
  resolved_at timestamptz
  resolved_by text
}

Table evidence_events {
  id uuid [pk]
  source_system text [not null]
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  evidence_type text [not null, note: 'LOW_CONFIDENCE/CONFLICTING_EVIDENCE/NAV_FAILED/HEARTBEAT_STALE']
  severity text [not null]
  trusted_for_policy boolean
  observed_at timestamptz
}

Table operator_actions {
  id uuid [pk]
  operator_id text [not null]
  action_type text [not null, note: 'MANUAL_CONFIRM/RELEASE_LOCK/RETRY_TASK/CANCEL_TASK/ADJUST_INVENTORY']
  target_entity_type text [not null]
  target_entity_id uuid [not null]
  reason text
  payload_json jsonb
  created_at timestamptz
}

Table manual_control_sessions {
  id uuid [pk]
  robot_id uuid [not null, ref: > robots.id]
  operator_id text [not null]
  status text [not null, note: 'ACTIVE/HANDOVER_REQUIRED/RECONCILING/CLOSED']
  reason text
  started_at timestamptz
  reconciled_at timestamptz
  closed_at timestamptz
  reconcile_snapshot_json jsonb
}

Table decision_snapshots {
  id uuid [pk]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  decision_type text [not null, note: 'RETRY_DECISION/MANUAL_REVIEW_GATE/RECOVERY_PLAN']
  normalized_input_json jsonb
  result_json jsonb
}

Table state_transitions {
  id uuid [pk]
  entity_type text [not null, note: 'TASK/TASK_STEP/ROBOT/COMMAND/INBOX/OUTBOX/MANUAL_SESSION']
  entity_id uuid [not null]
  from_status text
  to_status text [not null]
  reason_code text [not null]
  evidence_event_id uuid [ref: > evidence_events.id]
  command_id uuid [ref: > command_requests.id]
  decision_snapshot_id uuid [ref: > decision_snapshots.id]
  actor_id text
  created_at timestamptz
}

Ref: task_steps.nav_command_id > command_requests.id
