Project Scenario_70_Layered_Elements_Interfaces {
  database_type: 'PostgreSQL'
  Note: '''
  Layer view: separates hardware facts, state-control plane, log/audit/evidence plane, and service interfaces.
  This is a compact communication map, not a full physical schema.
  '''
}

Table systems {
  id uuid [pk]
  system_code text [unique, not null, note: 'MAIN_SERVER/NAV_SERVER/AI_SERVER/ROBOT_TB3_1/ROBOT_TB3_2/OPERATOR_UI']
  system_type text [not null, note: 'MAIN/NAV/AI/ROBOT/OPERATOR']
  responsibility text [not null]
  status text [not null]
}

Table service_identities {
  id uuid [pk]
  system_id uuid [ref: > systems.id]
  service_name text [unique, not null]
  service_type text [not null]
  auth_scheme text [not null, note: 'MTLS/HMAC/JWT/LOCAL_DEV']
  allowed_actions jsonb
  active boolean
}

Table interface_contracts {
  id uuid [pk]
  contract_code text [unique, not null, note: 'MAIN_TO_NAV_COMMAND/NAV_TO_MAIN_EVENT/AI_TO_MAIN_EVIDENCE/OPERATOR_TO_MAIN_ACTION']
  producer_system_id uuid [ref: > systems.id]
  consumer_system_id uuid [ref: > systems.id]
  transport text [not null, note: 'REST/WEBSOCKET/MQTT/ROS2_BRIDGE/DB_OUTBOX']
  message_type text [not null]
  required_fields_json jsonb
  idempotency_required boolean
  timeout_ms integer
  owner text
}

Table robots {
  id uuid [pk]
  system_id uuid [ref: > systems.id]
  robot_code text [unique, not null, note: 'tb3_1/tb3_2']
  namespace text [unique, not null]
  status text [not null, note: 'IDLE/MOVING/DOCKING/LIFTING/SAFETY_PAUSED/ERROR/OFFLINE']
  battery_level double
  last_heartbeat_at timestamptz
}

Table robot_capabilities {
  robot_id uuid [ref: > robots.id]
  capability text [note: 'NAVIGATION/LIFT/PICAMERA/ARUCO_DOCKING/SAFETY_STOP']
  enabled boolean
  config_json jsonb

  indexes {
    (robot_id, capability) [pk]
  }
}

Table evidence_sources {
  id uuid [pk]
  system_id uuid [ref: > systems.id]
  source_id text [unique, not null, note: 'global_cam_01/tb3_1_picam/tb3_2_picam/nav_tb3_1']
  source_system text [not null, note: 'AI_SERVER/NAV_SERVER/ROBOT']
  source_kind text [not null, note: 'GLOBAL_CAMERA/PICAMERA/NAV_STATUS/LIFT_SENSOR']
  robot_id uuid [ref: > robots.id]
  status text [not null]
  trusted_for_safety boolean
  trusted_for_inventory boolean
}

Table sensor_calibrations {
  id uuid [pk]
  calibration_code text [unique, not null]
  calibration_type text [not null, note: 'CAMERA_INTRINSIC/CAMERA_EXTRINSIC/HAND_EYE/MAP_CAMERA']
  version text [not null]
  calibration_json jsonb [not null]
  active boolean
}

Table sensor_mounts {
  id uuid [pk]
  evidence_source_id uuid [not null, ref: > evidence_sources.id]
  robot_id uuid [ref: > robots.id]
  calibration_id uuid [ref: > sensor_calibrations.id]
  mount_type text [not null, note: 'FIXED_GLOBAL/ROBOT_BODY/ROBOT_LIFT']
  frame_id text
  transform_json jsonb
}

Table robot_state_samples {
  id uuid [pk]
  robot_id uuid [not null, ref: > robots.id]
  pose_json jsonb
  velocity_json jsonb
  battery_level double
  nav_state text
  lift_state text
  observed_at timestamptz
}

Table lift_state_events {
  id uuid [pk]
  robot_id uuid [not null, ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  state text [not null, note: 'UP/DOWN/MOVING/ERROR']
  height_mm double
  load_detected boolean
  observed_at timestamptz
}

Table work_orders {
  id uuid [pk]
  order_type text [not null]
  status text [not null]
  priority integer
}

Table tasks {
  id uuid [pk]
  work_order_id uuid [ref: > work_orders.id]
  task_type text [not null]
  status text [not null]
  assigned_robot_id uuid [ref: > robots.id]
  priority integer
}

Table task_steps {
  id uuid [pk]
  task_id uuid [not null, ref: > tasks.id]
  sequence_no integer [not null]
  step_type text [not null]
  status text [not null]
  nav_command_id uuid
  evidence_policy_id uuid [ref: > evidence_policies.id]
}

Table evidence_policies {
  id uuid [pk]
  policy_name text [not null]
  step_type text [not null]
  version integer
  policy_json jsonb [not null]
  active boolean
}

Table reservations {
  id uuid [pk]
  reservation_type text [not null, note: 'ROBOT/SLOT/PALLET/ZONE']
  robot_id uuid [ref: > robots.id]
  task_id uuid [not null, ref: > tasks.id]
  status text [not null]
  expires_at timestamptz
}

Table resource_locks {
  id uuid [pk]
  resource_type text [not null]
  resource_id uuid [not null]
  task_id uuid [not null, ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  lock_status text [not null]
  expires_at timestamptz
}

Table scheduler_leases {
  step_id uuid [pk, ref: > task_steps.id]
  lease_owner text [not null]
  lease_token uuid [not null]
  heartbeat_at timestamptz
  expires_at timestamptz
}

Table command_requests {
  id uuid [pk]
  interface_contract_id uuid [ref: > interface_contracts.id]
  command_type text [not null, note: 'NAV_GOAL/DOCK_ARUCO/LIFT_UP/LIFT_DOWN/STOP/PAUSE/RESUME']
  target_system text [not null]
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  status text [not null]
  idempotency_key text [unique, not null]
  fencing_token uuid
  deadline_at timestamptz
}

Table safety_incidents {
  id uuid [pk]
  incident_type text [not null, note: 'HUMAN_DETECTED/ESTOP/ZONE_VIOLATION']
  status text [not null]
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  triggering_evidence_id uuid [ref: > evidence_events.id]
  stop_command_id uuid [ref: > command_requests.id]
}

Table decision_snapshots {
  id uuid [pk]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  decision_type text [not null, note: 'SCHEDULER_ASSIGNMENT/STEP_EVIDENCE_EVALUATION/SAFETY_INTERRUPT/RECOVERY_PLAN']
  normalized_input_json jsonb
  result_json jsonb
}

Table command_events {
  id uuid [pk]
  command_id uuid [not null, ref: > command_requests.id]
  source_system text [not null]
  external_event_id text [not null]
  event_type text [not null, note: 'ACCEPTED/STARTED/FEEDBACK/SUCCEEDED/FAILED/STOPPED']
  observed_at timestamptz
}

Table evidence_artifacts {
  id uuid [pk]
  artifact_type text [not null, note: 'IMAGE/VIDEO/JSON']
  uri text [not null]
  content_hash text
  pii_redacted boolean
  retention_until timestamptz
}

Table evidence_events {
  id uuid [pk]
  interface_contract_id uuid [ref: > interface_contracts.id]
  external_event_id text [not null]
  dedupe_key text [not null]
  source_system text [not null]
  source_id text
  robot_id uuid [ref: > robots.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  evidence_type text [not null, note: 'HUMAN_DETECTED/ARUCO_MARKER_DETECTED/LIFT_LOAD_DETECTED/SLOT_OCCUPIED_CONFIRMED']
  confidence double
  severity text [not null]
  trusted_for_policy boolean
  artifact_ref_id uuid [ref: > evidence_artifacts.id]
  observed_at timestamptz
}

Table api_call_logs {
  id uuid [pk]
  interface_contract_id uuid [ref: > interface_contracts.id]
  task_id uuid [ref: > tasks.id]
  step_id uuid [ref: > task_steps.id]
  command_id uuid [ref: > command_requests.id]
  target_system text [not null]
  method text [not null]
  url text [not null]
  response_status integer
  error_code text
  started_at timestamptz
  finished_at timestamptz
}

Table inbox_events {
  id uuid [pk]
  interface_contract_id uuid [ref: > interface_contracts.id]
  source_system text [not null]
  external_event_id text [not null]
  event_type text [not null]
  payload_json jsonb [not null]
  processing_status text [not null]
}

Table outbox_events {
  id uuid [pk]
  interface_contract_id uuid [ref: > interface_contracts.id]
  event_type text [not null]
  target_system text [not null]
  aggregate_type text [not null]
  aggregate_id uuid [not null]
  payload_json jsonb [not null]
  delivery_status text [not null]
}

Table dead_letter_events {
  id uuid [pk]
  source_table text [not null, note: 'inbox_events/outbox_events']
  source_event_id uuid [not null]
  reason_code text [not null]
  error_message text
  resolved_at timestamptz
}

Table operator_actions {
  id uuid [pk]
  operator_id text [not null]
  action_type text [not null, note: 'ACK_SAFETY/AUTHORIZE_RESUME/MANUAL_CONFIRM/CANCEL_TASK']
  target_entity_type text [not null]
  target_entity_id uuid [not null]
  reason text
  created_at timestamptz
}

Table state_transitions {
  id uuid [pk]
  entity_type text [not null]
  entity_id uuid [not null]
  from_status text
  to_status text [not null]
  reason_code text [not null]
  evidence_event_id uuid [ref: > evidence_events.id]
  command_id uuid [ref: > command_requests.id]
  decision_snapshot_id uuid [ref: > decision_snapshots.id]
  actor_id text
  created_at timestamptz
}

Ref: task_steps.nav_command_id > command_requests.id
